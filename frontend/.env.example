# ==========================================
# BUSLY FRONTEND - VERCEL ENVIRONMENT CONFIG
# ==========================================

# Production URL of your deployed Busly Express backend REST API
# e.g., https://busly-backend.onrender.com or https://api.yourdomain.com
NEXT_PUBLIC_API_URL=https://your-busly-backend.onrender.com

# Production URL of your deployed Busly Socket.IO server
# e.g., https://busly-backend.onrender.com or wss://api.yourdomain.com
NEXT_PUBLIC_SOCKET_URL=https://your-busly-backend.onrender.com

# Optional: Server-side proxy target to bypass CORS
BACKEND_URL=https://your-busly-backend.onrender.com
